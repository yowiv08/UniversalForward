<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Plugins.UniversalForward</RootNamespace>
    <Version>0.1.3</Version>
    <AssemblyName>Plugins.UniversalForward</AssemblyName>
    <Description>上游渠道管理、多 Key 分配、模型与协议配置、JSON/SSE 转发、请求头覆盖及连接测试。</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Router.Contracts" Version="2.0.0" />
    <EmbeddedResource Include="Web\*" />
    <EmbeddedResource Include="Contracts\*" />
    <Content Include="Contracts\CODEX-LICENSE.txt;Contracts\CODEX-NOTICE.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
